# 数据库
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 应用密钥
SECRET_KEY=your-secret-key

# 仅本地开发需要自动建表时设为 true；默认 false
AUTO_CREATE_TABLES=false

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://your-domain.com

# 公共内容默认关闭；仅显式配置后才对外展示
PUBLIC_POSTS_ENABLED=false
PUBLIC_POST_SLUG_ALLOWLIST=
PUBLIC_CHATTERS_ENABLED=false
PUBLIC_ALBUMS_ENABLED=false
PUBLIC_STATS_NAMESPACE=kirameku-wan-v1
# 可选，ISO 日期（YYYY-MM-DD）；公开接口只返回是否已配置
SITE_LAUNCH_DATE=

# GitHub OAuth（可选）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 阿里云 OSS（可选；不配置时仅上传接口不可用）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_CUSTOM_DOMAIN=
OSS_PREFIX=
